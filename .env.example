# ---------------------------------------------------------------
# Kamura Muebles 3D: variables de entorno
# Copiar a .env.local (desarrollo) o cargar en el hosting.
# NUNCA subir valores reales al repositorio.
# ---------------------------------------------------------------

# URL pública de la aplicación (sin barra final). Ej.: https://disena.kamuramuebles.com.ar
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secreto de la aplicación (mínimo 32 caracteres). Generar con: openssl rand -base64 48
APP_SECRET=

# Base de datos PostgreSQL (Supabase u otra). Si se omite en desarrollo, se usa PGlite en ./.data
# Supabase: Project Settings > Database > Connection string > "Transaction pooler" (puerto 6543)
DATABASE_URL=

# Acceso al panel /admin. Generar con: npm run admin:hash -- "contraseña larga"
ADMIN_PASSWORD_HASH=

# --- Asistente de IA (opcional; sin clave funciona en "modo básico") ---
# Google Gemini (nivel gratuito): https://aistudio.google.com/apikey
AI_API_KEY=
# Opcionales (valores por defecto para Gemini):
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-2.5-flash
# Alternativa Groq: AI_BASE_URL=https://api.groq.com/openai/v1  AI_MODEL=llama-3.3-70b-versatile
# Límite global de consultas por día (control de costos):
AI_DAILY_LIMIT=800

# --- Correo (opcional; Resend, 100 correos/día gratis) ---
RESEND_API_KEY=
# Remitente con dominio verificado en Resend. Ej.: Kamura Muebles <disena@kamuramuebles.com.ar>
MAIL_FROM=
# A dónde llegan los avisos de nuevas solicitudes
ADMIN_NOTIFY_EMAIL=

# --- Protección anti-spam adicional (opcional; Cloudflare Turnstile, gratis) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Contacto que se muestra en el sitio (opcional) ---
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=

# --- Medición (opcional; requieren consentimiento del visitante) ---
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Sitios que pueden mostrar la app dentro de un iframe
# FRAME_ANCESTORS='self' https://kamuramuebles.com.ar https://*.kamuramuebles.com.ar
